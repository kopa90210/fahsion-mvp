AI_PROVIDER_NAME=groq
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=qwen/qwen3.6-27b
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_MS=30000

