GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
SUPABASE_URL=
# You may use NEXT_PUBLIC_SUPABASE_URL instead of SUPABASE_URL if this is already set for Next.js.
SUPABASE_SERVICE_KEY=
ENABLE_AI_DAILY_OUTFITS=false

# Gate 4: Real Groq Vision Provider Configuration (Server-side only)
# Do NOT use NEXT_PUBLIC_* for sensitive keys. These must remain server-side.
